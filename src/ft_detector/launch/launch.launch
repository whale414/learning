<launch>
    <param name="use_sim_time" value="true"/>
    <rosparam command="load" file="$(find ft_detector)/config/yaml.yaml"/>
    <node pkg="ft_detector" type="test01" name="ft_detector_node" output="screen">
    <param name="image_transport" value="compressed" />
    <param name= "image_topic" value= "/hk_camera/image_raw"/>
    <param name="info_topic" value="/hk_camera/camera_info"/>
    <param name= "/use_sim_time" value="true"/>
    </node>

    <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view" args="/ft/debug/image" output="screen" />
    
</launch>
